# ================================================================
# allAbut — Cloudflare Pages 응답 헤더
# ================================================================
# 모든 페이지: 기본 보안 헤더
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# 404 페이지는 검색엔진에 나오지 않게
/404.html
  X-Robots-Tag: noindex

# ----------------------------------------------------------------
# 캐시: index.html 은 매번 새로 확인 (no-cache) → 새 배포의 ?v= 주소를 바로 받아요
#       js · css · 법적 문서는 주소에 ?v=커밋해시 가 붙어서 (build.sh) 배포마다 주소가 바뀌어요 → 길게 캐시해도 안전
#       (assets/ 이미지는 ?v= 가 없어서 기본 캐시 그대로)
# ----------------------------------------------------------------
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/config.js
  Cache-Control: public, max-age=31536000, immutable

/lang.js
  Cache-Control: public, max-age=31536000, immutable

/auth.js
  Cache-Control: public, max-age=31536000, immutable

/session.js
  Cache-Control: public, max-age=31536000, immutable

/app.js
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/lang/*
  Cache-Control: public, max-age=31536000, immutable

/legal/*
  Cache-Control: public, max-age=31536000, immutable

/cnc/*
  Cache-Control: public, max-age=31536000, immutable

/ui/*
  Cache-Control: public, max-age=31536000, immutable

# ----------------------------------------------------------------
# 파비콘 · 공유 이미지 · 검색 파일: 주소가 바뀌지 않아요 (?v= 없음 — 구글 파비콘 요건)
#   → immutable 로 오래 묶지 않고 하루만 캐시 (아이콘을 새로 만들면 하루 안에 바뀌어요)
# ----------------------------------------------------------------
/favicon.ico
  Cache-Control: public, max-age=86400

/assets/brand/*
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
