# ================================================================
# allAbut — Cloudflare Pages 응답 헤더
# ================================================================
# 모든 페이지: 기본 보안 헤더
#   Strict-Transport-Security: 1년 동안 이 사이트는 https 로만 열어요 (브라우저가 기억)
#   Permissions-Policy: 카메라 · 마이크 · 위치를 쓰지 않아요 (혹시 들어온 다른 코드도 못 써요)
#   Content-Security-Policy-Report-Only: 허용한 곳(우리 사이트 · Supabase · Cloudflare Turnstile · Google Fonts · jsDelivr · cdnjs)이
#     아닌 곳에서 스크립트 · 연결이 생기면 브라우저 개발자 도구(Console)에 경고만 남겨요. **아직 막지는 않아요(Report-Only)** —
#     한동안 경고가 없는지 확인한 뒤 이름을 Content-Security-Policy 로 바꾸면 실제로 막아요.
#     화면 버튼이 onclick="…" 을 쓰고 style 속성도 많아서 'unsafe-inline' 은 지금은 필요해요.
#     이미지는 광고 배너(관리자가 https 주소 등록)가 있어서 https: 전체 허용
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy-Report-Only: default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' blob: data: https://*.supabase.co wss://*.supabase.co https://challenges.cloudflare.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; frame-src 'self' blob: https://challenges.cloudflare.com https://*.supabase.co; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# 404 페이지는 검색엔진에 나오지 않게
/404.html
  X-Robots-Tag: noindex

# ----------------------------------------------------------------
# 캐시: index.html 은 매번 새로 확인 (no-cache) → 새 배포의 ?v= 주소를 바로 받아요
#       js · css · 법적 문서는 주소에 ?v=커밋해시 가 붙어서 (build.sh) 배포마다 주소가 바뀌어요 → 길게 캐시해도 안전
#       (assets/ 이미지는 ?v= 가 없어서 기본 캐시 그대로)
# ----------------------------------------------------------------
/
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/config.js
  Cache-Control: public, max-age=31536000, immutable

/lang.js
  Cache-Control: public, max-age=31536000, immutable

/loader.js
  Cache-Control: public, max-age=31536000, immutable

/theme.js
  Cache-Control: public, max-age=31536000, immutable

/auth.js
  Cache-Control: public, max-age=31536000, immutable

/session.js
  Cache-Control: public, max-age=31536000, immutable

/app.js
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/lang/*
  Cache-Control: public, max-age=31536000, immutable

/legal/*
  Cache-Control: public, max-age=31536000, immutable

/cnc/*
  Cache-Control: public, max-age=31536000, immutable

/ui/*
  Cache-Control: public, max-age=31536000, immutable

# ----------------------------------------------------------------
# 파비콘 · 공유 이미지 · 검색 파일: 주소가 바뀌지 않아요 (?v= 없음 — 구글 파비콘 요건)
#   → immutable 로 오래 묶지 않고 하루만 캐시 (아이콘을 새로 만들면 하루 안에 바뀌어요)
# ----------------------------------------------------------------
/favicon.ico
  Cache-Control: public, max-age=86400

/assets/brand/*
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

/robots.txt
  Cache-Control: public, max-age=3600

/sitemap.xml
  Cache-Control: public, max-age=3600
