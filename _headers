# ================================================================
# allAbut — Cloudflare Pages 응답 헤더
# ================================================================
# 모든 페이지: 기본 보안 헤더
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# 404 페이지는 검색엔진에 나오지 않게
/404.html
  X-Robots-Tag: noindex
